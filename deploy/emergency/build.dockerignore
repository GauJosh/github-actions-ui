# Build context for deploy/emergency/Dockerfile (passed with --ignorefile), as an allowlist like the UI's
# .dockerignore, plus the emergency sources. Private notes, docs, fixtures and examples stay out.
*
!package.json
!package-lock.json
!.npmrc
!index.html
!tsconfig.json
!vite.config.ts
!src/
!tools/
!tests/
!deploy/ui/
!deploy/emergency/

**/node_modules
**/.env
**/.env.*
**/*.pem
**/*.key
**/.DS_Store
