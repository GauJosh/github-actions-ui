# Build context for deploy/ui/Dockerfile, as an allowlist: only what `npm ci` and `npm run build` need. Everything
# else stays out, including private notes (CLAUDE.md, docs/), fixtures, screenshots, build and test output, git
# data and local environment files. Only the build output, the server and its header file reach the final image.
*
!package.json
!package-lock.json
!.npmrc
!index.html
!tsconfig.json
!vite.config.ts
!src/
!tools/
!tests/
!deploy/ui/

# Never, even inside an allowed folder.
**/node_modules
**/.env
**/.env.*
**/*.pem
**/*.key
**/.DS_Store
